GAMEAGENT_STUDIO_PORT=4242
GAMEAGENT_DAEMON_PORT=4243
GAMEAGENT_DESKTOP_START_TIMEOUT_SECONDS=45
GAMEAGENT_STUDIO_ORIGIN=http://127.0.0.1:4242
GAMEAGENT_DAEMON_URL=http://127.0.0.1:4243
GAMEAGENT_DAEMON_TOKEN=replace-with-at-least-32-random-characters
GAMEAGENT_PROJECT_PATH=C:/path/to/your/game
GAMEAGENT_REGISTRY_PATH=
# Optional canonical global expertise directory. Defaults to ~/.gameagent/knowledge.
GAMEAGENT_KNOWLEDGE_HOME=
GAMEAGENT_EXPERTISE_BENCHMARK_PATH=
# Comma-separated exact authoritative HTTPS hosts permitted for task research.
# Empty disables external research. Task network permission is also required.
GAMEAGENT_RESEARCH_HOSTS=
# Optional idle-only local capture/distillation. Never performs paid calls or promotion.
GAMEAGENT_BACKGROUND_LEARNING=0
GAMEAGENT_LEARNING_INTERVAL_SECONDS=60
# Local-only Ollama endpoint; required for Phase 8 inventory and benchmarks.
GAMEAGENT_OLLAMA_URL=http://localhost:11434
GAMEAGENT_OLLAMA_BENCHMARK_TIMEOUT_SECONDS=120
# Optional paid-provider adapter metadata. Credentials belong in the Providers UI,
# which stores them in the OS credential manager; never add them to this file.
GAMEAGENT_PROVIDER_ADAPTER_ID=
GAMEAGENT_PROVIDER_ENDPOINT=
GAMEAGENT_PROVIDER_MODEL=
GAMEAGENT_PROVIDER_INPUT_CENTS_PER_MILLION=
GAMEAGENT_PROVIDER_OUTPUT_CENTS_PER_MILLION=
# Optional: set when the current Codex executable is not available on PATH.
GAMEAGENT_CODEX_BIN=
# Optional: set when Python 3.12+ cannot be discovered on PATH.
GAMEAGENT_PYTHON=
